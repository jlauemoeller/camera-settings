{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Camera Settings",
  "mainBinaryName": "camera-settings",
  "identifier": "io.github.camera-settings.CameraSettings",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Camera Settings",
        "width": 1280,
        "height": 800,
        "minWidth": 640,
        "minHeight": 420,
        "backgroundColor": "#000000",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm"
    ],
    "category": "Video",
    "shortDescription": "Live preview, settings and test captures for the Logitech BRIO",
    "longDescription": "A small desktop app for the Logitech BRIO webcam: live preview, the safe UVC controls and field of view, stream modes, photo and video test captures. Survives the camera being unplugged at any moment.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "gstreamer1.0-plugins-base",
          "gstreamer1.0-plugins-good",
          "gstreamer1.0-plugins-bad",
          "gstreamer1.0-pipewire"
        ]
      },
      "rpm": {
        "depends": [
          "gstreamer1-plugins-base",
          "gstreamer1-plugins-good",
          "gstreamer1-plugins-bad-free",
          "pipewire-gstreamer"
        ]
      }
    }
  }
}
